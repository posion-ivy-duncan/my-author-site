---

import Navigation from "../../components/navigation.astro";

const book = {
  title: "Five Years and 2,000 Miles",
  series: "",
  tagline: "Can a friendship ruined by a kiss ever recover?",
  cover: "/images/five_years.jpg",

  description: `
    Five years ago, on a trip to visit his father for the summer, thirteen-year-old
    Leo Meyer made friends with the neighborhood boy Morgan Sloan. Leo got more
    from their relationship than he bargained for—his first kiss. Confused by his
    own feelings, Leo decided to cut his vacation short, leaving Morgan and their
    plans for the summer behind.

    Five years later, Leo still has regrets about running away that summer. But
    he’s given a second chance when he and Morgan both go off to college and fate
    brings them to the same school. While he’s interested in catching up, Morgan
    is dating a man who is less than fond of Leo. The last thing Leo wants to do
    is cause problems in Morgan’s relationship.

    Can Leo and Morgan come to terms with what happened between them and navigate
    friendship, or have they grown apart too much in the last five years?
  `,

  purchaseLinks: {
    amazon: "https://www.amazon.com/dp/B0CTJJQVW5?ref_=cm_sw_r_ffobk_cp_ud_dp_YVDZ7N3C9T94GEE0ZBM4&bestFormat=true",
    barnesAndNoble: "https://www.barnesandnoble.com/w/five-years-and-2000-miles-ivy-duncan/1148012428?ean=9798989985005",
    goodreads: "https://www.goodreads.com/book/show/206172655-five-years-and-2-000-miles",
  },

  reviews: [
    {
      quote: "Author really knows how to develop a character. Was afraid this coming of age book would be cliche. Wasn’t. Not even close. Interesting characters. Felt like I was transported into their lives. ",
      source: "Amazon",
    },
    {
      quote: "This book was a joy to read. It's filled with relatable characters, moments that make your heart squeeze, and a villain (maybe that's a strong word for him, but he certainly felt like a villain) that you're desperate to root against. It captures the anxieties of being a first year college student, and the complex emotions that can come along with unhealthy relationships. I loved getting to read about Sloan and Leo coming to terms with their feelings for each other, and both of their character developments as Leo comes out of his introverted shell, and Sloan begins to realize he deserves better than what his relationship with Drew is giving him. A perfectly paced slow burn that makes you root for the couple so much that you can't stop turning pages.",
      source: "Goodreads",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{book.title} | Ivy Duncan</title>
    <meta
      name="description"
      content={book.tagline}
    />
  </head>

  <body>

  <Navigation />

    <main>

      <!-- HERO / TITLE IMAGE -->

      <section class="book-hero">
        <div class="container book-hero-inner">

          <div class="book-cover">
            <img
              src={book.cover}
              alt={`Cover of ${book.title}`}
            />
          </div>

          <div class="book-title-content">
            <p class="eyebrow">Ivy Duncan</p>

            <h1>{book.title}</h1>

            {book.series && (
              <p class="series">{book.series}</p>
            )}

            <p class="tagline">
              {book.tagline}
            </p>
          </div>

        </div>
      </section>


      <!-- DESCRIPTION -->

      <section class="book-description">
        <div class="container narrow">

          <p class="eyebrow">The Story</p>

          <h2>Five years later, some feelings haven't changed.</h2>

          <div class="description">
            {book.description.split("\n\n").map((paragraph) => (
              <p>{paragraph.trim()}</p>
            ))}
          </div>

        </div>
      </section>
      
            <!-- TRIGGER WARNINGS -->

      <section class="trigger-warnings">
        <div class="container narrow">

          <p class="eyebrow">Before You Read</p>

          <h2>Trigger Warnings</h2>

          <p class="trigger-intro">
            Please take care of yourself while reading. This book contains
            references to the following:
          </p>

          <ul class="trigger-list">
            <li>Sexual Assult</li>
            <li>Emotional Abuse</li>
          </ul>

        </div>
      </section>



      <!-- PURCHASE / REVIEW LINKS -->

      <section class="book-links">
        <div class="container">

          <div class="links-header">
            <p class="eyebrow">Find the Book</p>

            <h2>Read the story</h2>

            <p>
              Find <em>{book.title}</em> at your favorite bookstore or
              leave a review after reading.
            </p>
          </div>

          <div class="link-grid">

            <a
              class="book-link"
              href={book.purchaseLinks.amazon}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Amazon</span>
              <small>Buy the book</small>
            </a>

            <a
              class="book-link"
              href={book.purchaseLinks.barnesAndNoble}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>B&amp;N</span>
              <small>Buy the book</small>
            </a>

            <a
              class="book-link"
              href={book.purchaseLinks.goodreads}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Goodreads</span>
              <small>Leave a review</small>
            </a>

          </div>

        </div>
      </section>

        <!-- BEHIND THE COVER -->

      <section class="behind-cover">
        <div class="container">

          <div class="behind-cover-header">
            <p class="eyebrow">Behind the Cover</p>

            <h2>How the cover came together.</h2>

            <p>
              I design my own book covers, and I am not at all an artist, so I 
              explore many different ideas before settling on the final design. 
              Here are some of the early sketches and alternate concepts that
              helped shape the cover of <em>{book.title}</em>.
            </p>
          </div>

          <div class="cover-gallery">

            <figure class="cover-image">
              <img
                src="/images/five_years_sketch.jpg"
                alt="Initial cover sketch for Five Years and 2,000 Miles"
              />
              <figcaption>
                The terrible sketch I shared with the artist creating the cover art.
              </figcaption>
            </figure>

            <figure class="cover-image">
              <img
                src="/images/five_years_alt_cover.jpg"
                alt="Alternate cover design for Five Years and 2,000 Miles"
              />
              <figcaption>
                One of the alternate cover designs.
              </figcaption>
            </figure>

            <figure class="cover-image">
              <img
                src="/images/five_years_characters.jpg"
                alt="Character artwork for Leo and Morgan"
              />
              <figcaption>
                Character artwork by <strong>Athena Dela Victoria</strong>.
              </figcaption>
            </figure>

          </div>

          <div class="artist-note">
            <p class="eyebrow">A Special Thank You</p>

            <h3>Character artwork</h3>

            <p>
              A special thank you to <strong>Athena Dela Victoria</strong> for bringing
              Leo and Morgan to life with these character drawings. I loved
              getting to see them take shape outside of my own imagination.
            </p>

            <a
              href="https://www.instagram.com/myrthena/"
              class="artist-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit their work →
            </a>
          </div>

        </div>
      </section>


      <!-- PURCHASE / REVIEW LINKS -->


      <!-- REVIEWS -->

      <section class="reviews">
        <div class="container">

          <div class="reviews-header">
            <p class="eyebrow">Reader Reviews</p>

            <h2>What readers are saying</h2>
          </div>

          <div class="review-grid">

            {book.reviews.map((review) => (
              <blockquote class="review">

                <p>“{review.quote}”</p>

                <footer>
                  — {review.source} reader
                </footer>

              </blockquote>
            ))}

          </div>

        </div>
      </section>

    </main>

  </body>
</html>


<style>
  /* =========================
     GLOBAL
  ========================== */

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;

    background: #fffaf4;
    color: #302c28;

    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(img) {
    max-width: 100%;
  }

  .container {
    width: min(1100px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .narrow {
    max-width: 800px;
  }

  .eyebrow {
    margin: 0 0 1rem;

    color: #765f48;

    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }


  /* =========================
     BOOK HERO
  ========================== */

  .book-hero {
    padding: 6rem 0;
    background: #f4efe7;
  }

  .book-hero-inner {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 5rem;
    align-items: center;
  }

  .book-cover img {
    width: 100%;
    display: block;

    box-shadow:
      0 20px 50px rgb(0 0 0 / 15%);
  }

  .book-title-content {
    max-width: 650px;
  }

  h1 {
    margin-bottom: 1.5rem;

    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .series {
    margin-bottom: 1.5rem;

    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tagline {
    margin: 0;

    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.5;
  }


  /* =========================
     DESCRIPTION
  ========================== */

  .book-description {
    padding: 7rem 0;
  }

  .book-description h2 {
    margin-bottom: 2.5rem;

    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .description p {
    margin-bottom: 1.5rem;

    font-size: 1.1rem;
  }

   /* =========================
     TRIGGER WARNINGS
  ========================== */

  .trigger-warnings {
    padding: 5rem 0;
    background: #f4efe7;
  }

  .trigger-warnings h2 {
    margin-bottom: 1.5rem;

    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .trigger-intro {
    max-width: 650px;
    margin-bottom: 1.5rem;

    font-size: 1rem;
  }

  .trigger-list {
    max-width: 650px;
    margin: 0;
    padding-left: 1.25rem;
  }

  .trigger-list li {
    margin-bottom: 0.6rem;

    font-size: 1rem;
  }

  .trigger-list li:last-child {
    margin-bottom: 0;
  }

    /* =========================
     BEHIND THE COVER
  ========================== */

  .behind-cover {
    padding: 7rem 0;
    background: #fffaf4;
  }

  .behind-cover-header {
    max-width: 700px;
    margin-bottom: 4rem;
  }

  .behind-cover-header h2 {
    margin-bottom: 1.5rem;

    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .behind-cover-header > p:last-child {
    margin-bottom: 0;

    font-size: 1.1rem;
    line-height: 1.7;
  }

  .cover-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .cover-image {
    margin: 0;
  }

  .cover-image img {
    display: block;
    width: 100%;
    height: auto;

    box-shadow: 0 12px 30px rgb(0 0 0 / 10%);
  }

  .cover-image figcaption {
    margin-top: 0.75rem;

    color: #765f48;

    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .artist-note {
    max-width: 700px;
    margin-top: 5rem;
    padding: 2.5rem;

    border-left: 3px solid #765f48;
    background: #f4efe7;
  }

  .artist-note h3 {
    margin-bottom: 1rem;

    font-size: 1.75rem;
    font-weight: 400;
  }

  .artist-note p:not(.eyebrow) {
    margin-bottom: 1.5rem;

    font-size: 1rem;
    line-height: 1.7;
  }

  .artist-link {
    color: #765f48;

    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .artist-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }


  /* =========================
     LINKS
  ========================== */

  .book-links {
    padding: 6rem 0;

    background: #f4efe7;
  }

  .links-header {
    max-width: 650px;
    margin-bottom: 3rem;
  }

  .links-header h2 {
    margin-bottom: 1rem;

    font-size: clamp(2rem, 4vw, 3rem);
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .book-link {
    padding: 1.75rem;

    border: 1px solid #d9d0c5;
    background: #fffaf4;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .book-link:hover {
    transform: translateY(-3px);

    box-shadow:
      0 10px 30px rgb(0 0 0 / 8%);
  }

  .book-link span {
    display: block;

    margin-bottom: 0.35rem;

    font-size: 1.25rem;
    font-weight: 700;
  }

  .book-link small {
    color: #765f48;

    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
  }


  /* =========================
     REVIEWS
  ========================== */

  .reviews {
    padding: 7rem 0;
  }

  .reviews-header {
    margin-bottom: 3rem;
  }

  .reviews-header h2 {
    margin-bottom: 0;

    font-size: clamp(2rem, 4vw, 3rem);
  }

  .review-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .review {
    margin: 0;
    padding: 2rem;

    border-left: 3px solid #765f48;

    background: #f4efe7;
  }

  .review p {
    margin-bottom: 1.5rem;

    font-size: 1.15rem;
    font-style: italic;
  }

  .review footer {
    color: #765f48;

    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }


  /* =========================
     MOBILE
  ========================== */

  @media (max-width: 700px) {

    .container {
      width: min(100% - 2rem, 600px);
    }

    .book-hero {
      padding: 4rem 0;
    }

    .book-hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .book-cover {
      max-width: 280px;
      margin: 0 auto;
    }

    .book-title-content {
      margin: 0 auto;
    }

    .link-grid {
      grid-template-columns: 1fr;
    }

    .review-grid {
      grid-template-columns: 1fr;
    }

    .book-description,
    .reviews {
      padding: 5rem 0;
    }

    .behind-cover {
      padding: 5rem 0;
    }

    .cover-gallery {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .artist-note {
      margin-top: 4rem;
      padding: 2rem;
    }
  }
</style>