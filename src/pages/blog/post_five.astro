```astro
---
import Navigation from "../../components/navigation.astro";
import { posts } from "../../data/posts.js";

const post = posts.find((post) => post.slug === "post_five");

if (!post) {
  throw new Error("Blog post not found.");
}

const { title, date, tags } = post;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Ivy Duncan</title>
    <meta
      name="description"
      content={post.excerpt}
    />
  </head>

  <body>
    <Navigation />

    <main>
      <article class="blog-post">
        <div class="container narrow">
          <header class="post-header">
            <p class="eyebrow">From the Blog</p>

            <h1>{title}</h1>

            <p class="post-date">{date}</p>

            <div class="post-tags">
              {tags.map((tag) => (
                <a
                  href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                  class="post-tag"
                >
                  {tag}
                </a>
              ))}
            </div>
          </header>

          <div class="post-content">
            <h2>My Bookshelves: Shelf One!</h2>

            <p>
              I figure, since I do want to fill this blog with stuff related to
              me, I could occasionally post a new shelf from my bookshelf to
              share a bit of what I've read with everyone.
            </p>

            <p>Shelf one is all BL.</p>

            <figure class="shelf-image">
              <img
                src="/images/blog/shelf_one.jpg"
                alt="The first shelf of Ivy's bookshelf, featuring a collection of BL manga."
              />
            </figure>

            <ul>
              <li>I Can't Get Through the Night Alone by Yoh Matsumoto</li>
              <li>All or Nothing by Shikke</li>
              <li>Lethal Dose of Love by Yosumi</li>
              <li>Wanna Be My Dress-Up Lover by Mamita</li>
              <li>My Instructor Won't Yield by Deme Kingyobachi</li>
              <li>I Didn't Mean to Fall in Love (#1 & #2) by Minta Suzumaru</li>
              <li>Light of My Life by Fuuko Minami</li>
              <li>
                How to Deal When Your Intimidating Neighbor Is Actually an Omega
                (#1 & #2) by Nikuya Inui
              </li>
              <li>Perfect Addiction (#1 & #2) by Kaoruko Miuama</li>
              <li>Clumsy Kiss by Machi Suehiro</li>
              <li>Fake Fact Lips (#1 & #2) by Machi Suehiro</li>
              <li>Yankee & Carameliser by Chiuko Umeshibu</li>
              <li>Call Me Master by Kedamashiba</li>
            </ul>

            <p><strong>Favorite thing on this shelf:</strong> Fake Fact Lips</p>
          </div>

          <footer class="post-footer">
            <a href="/blog" class="back-link">← Back to the blog</a>
          </footer>
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Ivy Duncan. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .container {
    width: min(1100px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .narrow {
    max-width: 800px;
    margin-inline: auto;
  }

  .blog-post {
    padding: 5rem 0;
  }

  .post-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #765f48;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-header h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
  }

  .post-date {
    margin: 1rem 0 0;
    color: #6f6a63;
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .post-tag {
    color: #765f48;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .post-tag:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content {
    color: #3f3a35;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .post-content p {
    margin: 0 0 1.5rem;
  }

  .post-content strong {
    color: #765f48;
  }

  .shelf-image {
    margin: 2rem 0 2.5rem;
  }

  .shelf-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .post-content ul {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content li {
    margin-bottom: 0.5rem;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd6cd;
  }

  .back-link {
    color: #765f48;
    font-family: system-ui, sans-serif;
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer {
    padding: 2rem 0;
    border-top: 1px solid #ddd6cd;
    color: #6f6a63;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .container {
      width: min(100% - 2rem, 1100px);
    }

    .blog-post {
      padding: 3.5rem 0;
    }
  }
</style>
```
