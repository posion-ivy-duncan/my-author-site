---
import Navigation from "../../components/navigation.astro";
import { posts } from "../../data/posts.js";

const post = posts.find((post) => post.slug === "post_six");

if (!post) {
  throw new Error("Blog post not found.");
}

const { title, date, tags } = post;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Ivy Duncan</title>
    <meta
      name="description"
      content={post.excerpt}
    />
  </head>

  <body>
    <Navigation />

    <main>
      <article class="blog-post">
        <div class="container narrow">
          <header class="post-header">
            <p class="eyebrow">From the Blog</p>

            <h1>{title}</h1>

            <p class="post-date">{date}</p>

            <div class="post-tags">
              {tags.map((tag) => (
                <a
                  href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                  class="post-tag"
                >
                  {tag}
                </a>
              ))}
            </div>
          </header>

          <div class="post-content">
            <h2>Not Interested Excerpt</h2>

            <p>
              As I've been editing, I came across an excerpt I wanted to share.
            </p>

            <blockquote>
              <p>
                “Why haven’t I seen you in the library?” Jason asked when he
                took his seat beside Luca in class a week later. As he spoke,
                he handed Luca a cup of coffee.
              </p>

              <p>
                Luca took a sip of the drink. “I haven’t been to the library in
                a week. The last time I went I didn’t get much studying done,
                so I’ve been studying in my room.”
              </p>

              <p>
                Jason raised his eyebrows. “Well, maybe you didn’t get work
                done last time because you left after ten minutes.”
              </p>

              <p>
                “Well, maybe I left after ten minutes because someone was
                distracting me.”
              </p>

              <p>
                “Well, maybe someone was distracting you because you looked
                like you wanted to be distracted.”
              </p>

              <p>
                Luca scoffed. “I highly doubt I looked like I wanted to be
                distracted.”
              </p>

              <p>
                “I think I need to buy you a mirror.”
              </p>
            </blockquote>
          </div>

          <footer class="post-footer">
            <a href="/blog" class="back-link">← Back to the blog</a>
          </footer>
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Ivy Duncan. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .container {
    width: min(1100px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .narrow {
    max-width: 800px;
    margin-inline: auto;
  }

  .blog-post {
    padding: 5rem 0;
  }

  .post-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #765f48;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-header h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
  }

  .post-date {
    margin: 1rem 0 0;
    color: #6f6a63;
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .post-tag {
    color: #765f48;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .post-tag:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content {
    color: #3f3a35;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .post-content p {
    margin: 0 0 1.5rem;
  }

  .post-content strong {
    color: #765f48;
  }

  .post-content blockquote {
    margin: 2.5rem 0;
    padding: 1.5rem 2rem;
    border-left: 3px solid #765f48;
    background: #f7f3ee;
  }

  .post-content blockquote p {
    margin: 0 0 1.25rem;
  }

  .post-content blockquote p:last-child {
    margin-bottom: 0;
  }

  .shelf-image {
    margin: 2rem 0 2.5rem;
  }

  .shelf-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .post-content ul {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content li {
    margin-bottom: 0.5rem;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd6cd;
  }

  .back-link {
    color: #765f48;
    font-family: system-ui, sans-serif;
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer {
    padding: 2rem 0;
    border-top: 1px solid #ddd6cd;
    color: #6f6a63;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .container {
      width: min(100% - 2rem, 1100px);
    }

    .blog-post {
      padding: 3.5rem 0;
    }

    .post-content blockquote {
      padding: 1.25rem 1.25rem;
      margin: 2rem 0;
    }
  }
</style>