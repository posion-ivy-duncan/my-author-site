---
import Navigation from "../components/Navigation.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | Ivy Duncan</title>
    <meta
      name="description"
      content="The page you're looking for couldn't be found."
    />
  </head>

  <body>
    <Navigation />

    <main class="not-found">
      <div class="container">
        <p class="eyebrow">404</p>

        <h1>This page doesn't seem to exist.</h1>

        <p class="message">
          Maybe try going back to the books?
        </p>

        <a href="/books" class="button button-primary">
          Browse My Books
        </a>

        <a href="/" class="back-home">
          Or go back home
        </a>
      </div>
    </main>

    <footer>
      <div class="container">
        <p>© 2026 Ivy Duncan. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(html) {
    background: #faf9f6;
  }

  :global(body) {
    margin: 0;
    background: #faf9f6;
    color: #2f2a25;
    font-family: Georgia, "Times New Roman", serif;
  }

  .container {
    width: min(1100px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .not-found {
    min-height: 65vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 5rem 0;
  }

  .not-found .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #765f48;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
  }

  .message {
    max-width: 500px;
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .button-primary {
    background: #765f48;
    color: #fff;
  }

  .back-home {
    margin-top: 1rem;
    color: #765f48;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  footer {
    padding: 2rem 0;
    border-top: 1px solid #e5dfd6;
    text-align: center;
  }

  footer p {
    margin: 0;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .container {
      width: min(100% - 2rem, 1100px);
    }

    .not-found {
      min-height: 60vh;
      padding: 4rem 0;
    }
  }
</style>